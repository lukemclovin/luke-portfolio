---
//Component Script (TypeScript)
//Props are parameters passed into this component when you use it.
interface Props {
  title: string;
  engine: string;
  role: string;
  description: string;
  slug: string; // Added slug prop
}

//Destructure - a shorthand from Astro to use in another file
const { title, engine, role, description, slug } = Astro.props;
---

<!-- HTML Structure -->
<article class="card">
  <h3>
    <a href={`/projects/${slug}`}>{title}</a>
  </h3>
  <p class="meta"><strong>Engine:</strong> {engine} | <strong>Role:</strong> {role}</p>
  <p>{description}</p>
  <a href={`/projects/${slug}`} class="details-link">View Project Details &rarr;</a>
</article>

<!-- Styles (CSS) - Astro automatically isolates these styles to this card only -->
<style>
  .card {
    background: #1e1e1e;
    border: 1px solid #333;
    padding: 24px;
    border-radius: 8px;
    margin-bottom: 20px;
  }

  h3 { margin-top: 0; margin-bottom: 8px; font-size: 24px; }
  h3 a { color: #fff; text-decoration: none; }
  h3 a:hover { color: #818cf8; }

  .meta { color: #888; font-size: 14px; margin-bottom: 12px; }

  p { margin: 0 0 16px 0; color: #ccc; line-height: 1.5; }

  .details-link { color: #818cf8; text-decoration: none; font-weight: 500; font-size: 14px; }
  
  .details-link:hover { text-decoration: underline; }
</style>