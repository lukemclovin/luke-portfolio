---
//Component Script (TypeScript)
//Props are parameters passed into this component when you use it.
interface Props {
  title: string;
  engine: string;
  role: string;
  description: string;
}

//Destructure - a shorthand from Astro to use in another file
const { title, engine, role, description } = Astro.props;
---

<!-- HTML Structure -->
<article class="card">
  <h3>{title}</h3>
  <p class="meta"><strong>Engine:</strong> {engine} | <strong>Role:</strong> {role}</p>
  <p>{description}</p>
</article>

<!-- Styles (CSS) - Astro automatically isolates these styles to this card only -->
<style>
  .card {
    background: #1e1e1e;
    border: 1px solid #333;
    padding: 24px;
    border-radius: 8px;
    margin-bottom: 20px;
  }

  h3 {
    margin-top: 0;
    margin-bottom: 8px;
    color: #fff;
    font-size: 24px;
  }

  .meta {
    color: #888;
    font-size: 14px;
    margin-bottom: 12px;
  }

  p {
    margin: 0;
    color: #ccc;
    line-height: 1.5;
  }
</style>