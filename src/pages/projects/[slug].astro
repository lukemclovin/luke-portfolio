---
//The slug serves as a template for page

import MainLayout from '../../layouts/MainLayout.astro';

//Tell Astro which static pages to generate during build
export async function getStaticPaths() {
    //An array of projects
  const projects = [
    {
      slug: 'skull-mania',
      title: 'Skull Mania',
      tagline: 'Grab death by the head...',
      techStack: 'VR, UE5.6, Blueprints, Android Studio',
      role: 'Solo Developer',
      overview: 'In Skull Mania, you begin with 3 switches in front of you. You must activate these switches to open the locked door ahead. The rooms that surround you are full of skulls. Find the item you need from each room to activate the switches, open the door, and escape! Ramp up the difficulty in Level 2 where you must also kill the music coming from one the rooms!',
      trailerUrl: '/media/skullMania/skull-mania-mixed-reality-trailer-compressed.mp4',
      trailerThumbnail: '/media/skullMania/skull-mania-thumbnail.JPG',
      linkString: 'Download from SideQuest',
      link: 'https://sidequestvr.com/app/54339/skull-mania',
      screenshots: [
        '/media/skullMania/skullManiaFirstDoor.png',
        '/media/skullMania/skull-mania-room.png',
        '/media/skullMania/skull-mania-scooped-skulls.png',
        '/media/skullMania/skull-mania-speaker-cube.png',
        '/media/skullMania/skullManiaGoldenSkull.png',
        '/media/skullMania/skull-mania-main-menu.png',
      ],
      keyFeature1: 'Spatialized Audio',
      keyFeature1Overview: [
        'Sound cues can be found throughout the game, such as the speaker cube from Level 2 or the torches found on the walls. The sound emitting from these game objects is localized and appropriate for the item. For instance, the music coming from the speaker will get louder as the player gets closer to it, providing a clue as to where it can be found. ', 
      ],
      keyFeature2: 'Grab Mechanics',
      keyFeature2Overview: [
        'Skull Mania relies on grab mechanics using the VR motion controller. The player can grab items directly or use tools such as the scooper to move and sort through a big pile, bringing the item to an easier position.  '
      ],
      keyFeature3: 'Wrist-mounted Widgets ',
      keyFeature3Overview: [
        'A ‘Hints’ widget can be optionally viewed from the player’s left wrist that will update with clues as you move throughout the level. The main menu can be accessed from the right wrist allowing for easy access to level loading and reloading. '
      ],
      // challenge1: 'Technical Challenge 1',
      // challenge1Overview: [
      //   'Technical Challenge 1 overview point 1.',
      // ],
      // challenge2: '',
      // challenge2Overview: [

      // ],
      // challenge3: '',
      // challenge3Overview: [

      // ],
      disclaimer: '',
    },
    {
      slug: 'vision-bound',
      title: 'VisionBound',
      tagline: 'Find the edge of what you can see...',
      techStack: 'VR, UE5.6, Blueprints, Android Studio',
      role: 'Solo Developer, Academic Researcher',
      overview: 'VisionBound is a proof of concept VR adaptation of Visual Restitution Therapy (VRT), a therapy designed to help restore lost areas of a person’s visual field. In VRT, bright visual stimuli are shown one by one along the border of the person’s visual field while they focus on a central point. VisionBound uses head tracking to reduce the effect of compensatory head movements when scanning for the stimuli and provides a larger area than the traditionally used computer screen for the stimuli to spawn in.',
      trailerUrl: '/media/visionBound/vision-bound-trailer-compressed.mp4',
      trailerThumbnail: '/media/visionBound/vision-bound-thumbnail.JPG',
      linkString: 'Download from SideQuest',
      link: 'https://sidequestvr.com/app/59959/visionbound',
      screenshots: [
        '/media/visionBound/vision-bound-visual-stimulus-skull.jpeg',
        '/media/visionBound/vision-bound-calibration-point-left-skull.jpeg',
        '/media/visionBound/vision-bound-visual-stimulus-sphere.jpeg',
        '/media/visionBound/vision-bound-main-menu.jpeg',
        '/media/visionBound/vision-bound-results.jpeg',
        '/media/visionBound/vision-bound-customization.jpeg',
      ],
      keyFeature1: 'Calibration',
      keyFeature1Overview: [
        'The user can calibrate their visual field by providing an input when they can no longer see a calibration point which moves in the left, right, up, and down direction from a central focus point. ', 
      ],
      keyFeature2: 'Stimulus Spotting Sequence',
      keyFeature2Overview: [
        'The user’s intact-defect border of their visual field which extends the least will be calculated from calibration, and visual stimuli will spawn along this border. This, in theory, will help to restore this part of the user’s visual field.'
      ],
      keyFeature3: 'Customization',
      keyFeature3Overview: [
        'To make the process more fun, the user can choose what their focus point looks like, the point where they will keep their gaze throughout the process. For instance, they can choose a ’skull and bones’, making sure the skull stays aligned with the bones.'
      ],
      // challenge1: 'Technical Challenge 1',
      // challenge1Overview: [
      //   'Technical Challenge 1 overview point 1.',
      // ],
      // challenge2: '',
      // challenge2Overview: [

      // ],
      // challenge3: '',
      // challenge3Overview: [

      // ],
      disclaimer: 'This application is the product of an academic research project, and does not guarantee the restoration of one’s visual field.'
    },
    {
      slug: 'house-checks',
      title: 'House Checks',
      tagline: 'Make sure everything is sorted before you go to bed...',
      techStack: 'Unity 6, C#',
      role: 'Solo Developer',
      overview: 'Have you switched all the lights off? Locked the front door? Turned your PC off? House Checks is a 2D, top-down Serious Game aimed at enforcing an evening routine. It features an accessibility-focused, cyclic UI with a one-button input system. You must move from room to room, make sure your house is safe and secure, and earn your sleep.',
      trailerUrl: '/media/houseChecks/house-checks-trailer.mp4',
      trailerThumbnail: '/media/houseChecks/house-checks-thumbnail.png',
      linkString: 'Unavailable',
      link: '',
      screenshots: [
        '/media/houseChecks/house-checks-screenshot1.png',
        '/media/houseChecks/house-checks-screenshot2.png',
        '/media/houseChecks/house-checks-screenshot3.png',
        '/media/houseChecks/house-checks-screenshot4.png',
        '/media/houseChecks/house-checks-screenshot5.png',
        '/media/houseChecks/house-checks-screenshot6.png',
      ],
      keyFeature1: 'Cyclic UI',
      keyFeature1Overview: [
        'Actions are controlled through a UI that cycles at a controlled, steady rate, with distinct color changes and sound cues. This gives the user time to consider which action to take, and welcomes a wider player audience through accessibility.', 
      ],
      keyFeature2: 'One-button Input System',
      keyFeature2Overview: [
        'House Checks has been designed around a one-button input system. The input can be mapped to any key, accessibility switch, used as a left mouse click or on touchscreen.'
      ],
      keyFeature3: '',
      keyFeature3Overview: [
        
      ],
      // challenge1: 'Technical Challenge 1',
      // challenge1Overview: [
      //   'Technical Challenge 1 overview point 1.',
      // ],
      // challenge2: '',
      // challenge2Overview: [

      // ],
      // challenge3: '',
      // challenge3Overview: [

      // ],
      disclaimer: '',
    },
    {
      slug: 'for-reel',
      title: 'ForReel',
      tagline: '',
      techStack: 'Java, Firebase, Android Studio',
      role: 'Solo Developer',
      overview: 'ForReel is an Android-native mobile app where you can search for films and find out where to stream them in the UK. You can also add films to \'Reels\', which are similar to playlists on Spotify. Say you\'re in the mood to watch an Adam Sandler film, just check out your Adam Sandler Reel! Maybe you it\'s Christmas time and you fancy watching a Christmas classic, take a look in your Christmas Reel!',
      trailerUrl: '/media/forReel/for-reel-trailer-compressed.mp4',
      trailerThumbnail: '/media/forReel/for-reel-thumbnail.png',
      linkString: 'Unavailable',
      link: '',
      screenshots: [
        '/media/forReel/for-reel-login.png',
        '/media/forReel/for-reel-homepage.png',
        '/media/forReel/for-reel-search.png',
        '/media/forReel/for-reel-film-page.png',
        '/media/forReel/for-reel-reel-list.png',
        '/media/forReel/for-reel-reel-page.png',
      ],
      keyFeature1: 'Live API Integration',
      keyFeature1Overview: [
        'ForReel uses an API for film names, posters, overviews, and streaming information. The app updates in real time so the information is always up to date. keeping the homepage fresh with sections like \'Currently Trending\'.', 
      ],
      keyFeature2: 'Firebase',
      keyFeature2Overview: [
        'Firestore has been integrated to store datasets, such as films in a user\'s Reel, and secure authentication for any user account information.'
      ],
      keyFeature3: '',
      keyFeature3Overview: [
        
      ],
      // challenge1: 'Technical Challenge 1',
      // challenge1Overview: [
      //   'Technical Challenge 1 overview point 1.',
      // ],
      // challenge2: '',
      // challenge2Overview: [

      // ],
      // challenge3: '',
      // challenge3Overview: [

      // ],
      disclaimer: '',
    },
    {
      slug: 'tairu-shototsu',
      title: 'Tairu Shōtotsu',
      tagline: '',
      techStack: 'Java, Processing',
      role: 'Solo Developer',
      overview: 'Ever played the coin gambling game \'Zeni Hajiki\' from PlayStation\'s \'Ghost of Yotei\'? This is basically that. Tairu Shōtotsu roughly translates from Japanese to Tile Collision. It\'s a two-player, 1v1 game where you flick tiles into other tiles for points. Featuring customizable physics parameters allowing you to create chaos!',
      trailerUrl: '/media/tairuShototsu/tairu-shototsu-trailer-compressed.mp4',
      trailerThumbnail: '/media/tairuShototsu/tairu-shototsu-screenshot-1.png',
      linkString: 'Unavailable',
      link: '',
      screenshots: [
        '/media/tairuShototsu/tairu-shototsu-rules.png',
        '/media/tairuShototsu/tairu-shototsu-screenshot-1.png',
        '/media/tairuShototsu/tairu-shototsu-screenshot-2.png',
        '/media/tairuShototsu/tairu-shototsu-screenshot-3.png',
        '/media/tairuShototsu/tairu-shototsu-screenshot-4.png',
        '/media/tairuShototsu/tairu-shototsu-screenshot-5.png',
      ],
      keyFeature1: 'Customizable Physics',
      keyFeature1Overview: [
        'Players can use the sliders on the right of the screen to make live changes to the physics of the game. Such changes include the amount of friction between the tiles and the table, the power of the flick, the level of gravity, and the tiles\' mass.', 
      ],
      keyFeature2: 'Game Parameters',
      keyFeature2Overview: [
        'The game parameters, such as number of points needed to win or number of tiles on the table, can also be changed both before and during a match-up.'
      ],
      keyFeature3: '',
      keyFeature3Overview: [
        
      ],
      // challenge1: 'Technical Challenge 1',
      // challenge1Overview: [
      //   'Technical Challenge 1 overview point 1.',
      // ],
      // challenge2: '',
      // challenge2Overview: [

      // ],
      // challenge3: '',
      // challenge3Overview: [

      // ],
      disclaimer: '',
    },
  ];

  return projects.map((project) => ({
    params: { slug: project.slug }, //Replace 'slug' with the appropriate project (e.g. skull mania)
    props: { project }, //Retrieve the project from the array
  }));
}

//Destructure
const { project } = Astro.props;
---

<MainLayout title={project.title}>
  <a href="/" class="back-link" onclick="if (history.length > 1 && document.referrer.includes(window.location.host)) { history.back(); return false; }">
    &larr; Back
  </a>
  
  <article class="project-detail">
    <header>
      <h1>{project.title}</h1>
      <p class="tagline">{project.tagline}</p>
      <p class="meta"><strong>Tech Stack:</strong> {project.techStack} | <strong>Role:</strong> {project.role}</p>
    </header>

    <section class="section">
      <h2>Overview</h2>
      <p>{project.overview}</p>
    </section>

    {project.trailerUrl && (
      <section class="section video-section">
        <h2>Trailer</h2>
        <div class="video-wrapper">
          <video controls poster={project.trailerThumbnail}, preload="metadata" playsinline class="trailer-thumbnail">
            <source src={project.trailerUrl} type="video/mp4" />
            Your browser does not support the video tag.
          </video>
        </div>
      </section>
    )}

    <section class="section">
      <h2>Code/Downloads</h2>
      <a href={project.link} target="_blank" class="btn">{project.linkString}</a>
    </section>

    {project.screenshots && project.screenshots.length > 0 && (
      <section class="section">
        <h2>Media Gallery</h2>
        <div class="gallery">
          {project.screenshots.map((imgSrc, index) => (
            <a href={imgSrc} target="_blank" rel="noopener noreferrer">
              <img src={imgSrc} alt={`${project.title} screenshot ${index + 1}`} loading="lazy" />
            </a>
          ))}
        </div>
      </section>
    )}
    
    <section class="section">
      <h2>Key Features</h2>
      <p>{project.keyFeature1}</p>
      <ul class="bullet">
        {project.keyFeature1Overview.map((item) => <li>{item}</li>)}
      </ul>
      <p>{project.keyFeature2}</p>
      <ul class="bullet">
        {project.keyFeature2Overview.map((item) => <li>{item}</li>)}
      </ul>
      <p>{project.keyFeature3}</p>
      <ul class="bullet">
        {project.keyFeature3Overview.map((item) => <li>{item}</li>)}
      </ul>
    </section>

    <!-- <section class="section">
      <h2>Technical Challenges</h2>
      <p>{project.challenge1}</p>
      <ul class="bullet">
        {project.challenge1Overview.map((item) => <li>{item}</li>)}
      </ul>
      <p>{project.challenge2}</p>
      <ul class="bullet">
        {project.challenge2Overview.map((item) => <li>{item}</li>)}
      </ul>
      <p>{project.challenge3}</p>
      <ul class="bullet">
        {project.challenge3Overview.map((item) => <li>{item}</li>)}
      </ul>
    </section> -->

    <p class="disclaimer">{project.disclaimer}</p>
    
  </article>
</MainLayout>

<style>
  .back-link { color: #818cf8; text-decoration: none; display: inline-block; }
  
  h1 { font-size: 60px; margin-bottom: 10px; color: #fff; text-align: center; }

  .tagline { font-size: 20px; font-style:italic; color: #fff; margin-bottom: 10px; margin-top: 10px; text-align: center; }
  
  .meta { color: #888; font-size: 16px; margin-bottom: 30px; text-align: center;}
  
  .section { margin-bottom: 40px; border-bottom: 1px solid #222; padding-bottom: 20px; }
  
  h2 { font-size: 24px; color: #818cf8; margin-bottom: 12px; }
  
  p { line-height: 1.6; color: #ccc; font-size: 18px; }
  
  .bullet { color: #ccc; line-height: 1.8; }
  
  .disclaimer { font-size: 10px; font-style:italic; color: #888; margin-top: 20px; text-align: center; }

  .btn { 
    display: inline-block; 
    /* width: fit-content;
    margin: 0 auto; */ /* Center the button */
    background: #4f46e5; 
    color: white; 
    padding: 10px 18px; 
    border-radius: 6px; 
    text-decoration: none; 
    font-weight: bold; 
  }
  
  .btn:hover { background: #4338ca; }

  .video-wrapper {
    max-width: 800px;
    margin: 0 auto;
  }

  .video-wrapper video {
    width: 100%;
    height: auto;
    border-radius: 8px;
    border: 1px solid #333;
    background: #000;
    display: block;
    margin: 0 auto;
  }

  .trailer-thumbnail {
    width: 100%;
    aspect-ratio: 16 / 9;      /* Forces a universal video player proportion */
    object-fit: cover;         /* Scales poster images to fill the player without stretching */
    border-radius: 8px;        /* Optional: matches modern card styling */
    background-color: #000;    /* Prevents white flashes while loading */
  }

  .gallery {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 16px;
    margin-top: 12px;
  }

  .gallery a {
    display: block;
    width: 100%;
    aspect-ratio: 16 / 10;
    overflow: hidden;
    border-radius: 6px;
  }

  .gallery img {
    display: block;
    width: 100%;
    height: 75%;
    object-fit: cover;
    border-radius: 6px;
    border: 1px solid #333;
    transition: transform 0.2s ease, border-color 0.2s ease;
  }

  .gallery img:hover {
    transform: translateY(-2px);
    border-color: #818cf8;
  }

  /* gallery becomes 1 column on mobile */
  @media (max-width: 600px) {
    .gallery {
      grid-template-columns: 1fr;
    }
  }
</style>