---
//The slug serves as a template for page

import MainLayout from '../../layouts/MainLayout.astro';

//Tell Astro which static pages to generate during build
export async function getStaticPaths() {
    //An array of projects
  const projects = [
    {
      slug: 'skull-mania',
      title: 'Skull Mania',
      engine: 'Unreal Engine 5 (Blueprints)',
      role: 'Solo Developer',
      overview: 'A search-and-sort VR game with a medievil-horror environment, featuring realistic physics and dynamic object interactions.',
      tech: ['C++', 'Unreal Engine 5', 'Chaos Physics'],
      link: 'https://sidequestvr.com/app/54339/skull-mania',
      linkString: 'Download from SideQuest',
      trailerUrl: '/media/skull-mania-mixed-reality-trailer-compressed.mp4',
      screenshots: [
        '/media/skullManiaFirstDoor.png',
        '/media/skullManiaGoldenSkull.png',
        '/media/skull-mania-scooped-skulls.png',
        '/media/skull-mania-room.png',
      ]
    },
    // {
    //   slug: 'vision-bound',
    //   title: 'Procedural Dungeon Crawler',
    //   engine: 'Unity (C#)',
    //   role: 'Solo Developer',
    //   overview: 'A top-down action game featuring procedurally generated level layouts based on the Wave Function Collapse algorithm.',
    //   tech: ['C#', 'Unity', 'A* Pathfinding'],
    //   link: 'https://github.com/yourusername/project',
    //   linkString: 'View on GitHub',
    //   trailerUrl: '/media/skull-mania-mixed-reality-trailer.mp4',
    //     screenshots: [
    //       '/media/skullManiaFirstDoor.png',
    //       '/media/skullManiaGoldenSkull.png',
    //       '/media/skull-mania-scooped-skulls.png',
    //     ]
    // },
  ];

  return projects.map((project) => ({
    params: { slug: project.slug }, //Replace 'slug' with the appropriate project (e.g. skull mania)
    props: { project }, //Retrieve the project from the array
  }));
}

//Destructure
const { project } = Astro.props;
---

<MainLayout title={project.title}>
  <a href="/" class="back-link" onclick="if (history.length > 1 && document.referrer.includes(window.location.host)) { history.back(); return false; }">
    &larr; Back
  </a>
  
  <article class="project-detail">
    <header>
      <h1>{project.title}</h1>
      <p class="meta"><strong>Engine:</strong> {project.engine} | <strong>Role:</strong> {project.role}</p>
    </header>

    <section class="section">
      <h2>Overview</h2>
      <p>{project.overview}</p>
    </section>

    {project.trailerUrl && (
      <section class="section video-section">
        <h2>Trailer</h2>
        <div class="video-wrapper">
          <video controls poster={project.screenshots?.[project.screenshots.length - 1]}, preload="metadata" playsinline>
            <source src={project.trailerUrl} type="video/mp4" />
            Your browser does not support the video tag.
          </video>
        </div>
      </section>
    )}

    <section class="section">
      <h2>Technologies Used</h2>
      <ul class="tech-list">
        {project.tech.map((item) => <li>{item}</li>)}
      </ul>
    </section>

    {project.screenshots && project.screenshots.length > 0 && (
      <section class="section">
        <h2>Media Gallery</h2>
        <div class="gallery">
          {project.screenshots.map((imgSrc, index) => (
            <a href={imgSrc} target="_blank" rel="noopener noreferrer">
              <img src={imgSrc} alt={`${project.title} screenshot ${index + 1}`} loading="lazy" />
            </a>
          ))}
        </div>
      </section>
    )}

    <section class="section">
      <h2>Code & Downloads</h2>
      <a href={project.link} target="_blank" class="btn">{project.linkString}</a>
    </section>
  </article>
</MainLayout>

<style>
  .back-link { color: #818cf8; text-decoration: none; display: inline-block; }
  
  h1 { font-size: 40px; margin-bottom: 10px; color: #fff; }
  
  .meta { color: #888; font-size: 16px; margin-bottom: 30px; }
  
  .section { margin-bottom: 40px; border-bottom: 1px solid #222; padding-bottom: 20px; }
  
  h2 { font-size: 24px; color: #818cf8; margin-bottom: 12px; }
  
  p { line-height: 1.6; color: #ccc; font-size: 18px; }
  
  .tech-list { color: #ccc; line-height: 1.8; }
  
  .btn { display: inline-block; background: #4f46e5; color: white; padding: 10px 18px; border-radius: 6px; text-decoration: none; font-weight: bold; }
  
  .btn:hover { background: #4338ca; }

  /* Video Player Styling */
  .video-wrapper {
    max-width: 800px;
    margin: 0 auto;
  }

  .video-wrapper video {
    width: 75%;
    height: auto;
    border-radius: 8px;
    border: 1px solid #333;
    background: #000;
    display: block;
    margin: 0 auto;
  }

  /* Screenshot Gallery Styling */
  .gallery {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 16px;
    margin-top: 12px;
  }

  .gallery a {
    display: block;
    text-decoration: none;
  }

  .gallery img {
    display: block;
    width: 100%;
    object-fit: cover;
    border-radius: 6px;
    border: 1px solid #333;
    transition: transform 0.2s ease, border-color 0.2s ease;
  }

  .gallery img:hover {
    transform: translateY(-2px);
    border-color: #818cf8;
  }

  /* Optional: Automatically drops to 1 column on mobile screens so images don't get squished */
  @media (max-width: 600px) {
    .gallery {
      grid-template-columns: 1fr;
    }
  }
</style>