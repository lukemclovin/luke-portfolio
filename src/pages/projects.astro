---
import MainLayout from '../layouts/MainLayout.astro';
import ProjectCard from '../components/ProjectCard.astro';
---
<MainLayout title="Ibberson Studios | Projects">
  <h1>All Projects</h1>
  <ProjectCard 
    title="Skull Mania" 
    techStack="VR, UE5.6, Blueprints, Android Studio" 
    role="Solo Developer" 
    description="A search-and-sort VR game with a medievil-horror environment, featuring realistic physics and dynamic object interactions."
    slug = "skull-mania"
  />
  <ProjectCard 
    title="VisionBound" 
    techStack="VR, UE5.6, Blueprints, Android Studio" 
    role="Solo Developer" 
    description="A VR adaptation of Visual Resitution Therapy, designed to mitigate the effects of compensatory head movement and lack of accessibilty observed in clinical treatments."
    slug = "vision-bound"
  />
  <ProjectCard 
    title="House Checks" 
    techStack="Unity 6, C#" 
    role="Solo Developer" 
    description="An accessibility-focused, top-down Serious Game aimed at reinforcing an evening routine."
    slug = "house-checks"
  />
  <ProjectCard 
    title="ForReel" 
    techStack="Java, Firebase, Android Studio" 
    role="Solo Developer" 
    description="An Android-native mobile application for information on where films can be streamed in the UK."
    slug = "for-reel"
  />
  <ProjectCard 
    title="Tairu Shōtotsu" 
    techStack="Java, Processing" 
    role="Solo Developer" 
    description="A two-player, physics-based collision game based on fictional Japanese coin gambling."
    slug = "tairu-shototsu"
  />
</MainLayout>