---
import MainLayout from '../layouts/MainLayout.astro';
import ProjectCard from '../components/ProjectCard.astro';
---

<MainLayout title="Ibberson Studios">
  <section class="hero">
    <img src="/logos/ibberson-studios-logo-topbottom-transparent(1).PNG" alt="Ibberson Studios Logo" class="hero-logo" />
    <h1>Luke Ibberson</h1>
    <h2>Computer Science (Games Technology) Developer</h2>
    <!-- <p></p> -->
  </section>

  <section class="projects">
    <h3>Featured Projects</h3>
    <ProjectCard 
      title="Skull Mania" 
      engine="Unreal Engine 5 (Blueprints)" 
      role="Solo Developer" 
      description="A search-and-sort VR game with a medievil-horror environment, featuring realistic physics and dynamic object interactions."
      slug = "skull-mania"
    />
    <!-- <ProjectCard 
      title="Procedural Dungeon Crawler" 
      engine="Unity (C#)" 
      role="Solo Developer" 
      description="Built a grid-based dungeon generator using Wave Function Collapse and custom pathfinding AI."
      slug = "vision-bound"
    /> -->
  </section>
</MainLayout>

<style>
  .hero {
    margin-bottom: 40px;
  }

  .hero-logo {
    width: 500px;
    height: auto;
    margin-bottom: 16px;
    display: block;
    margin: auto;
  }
  
  h1 { font-size: 48px; margin-bottom: 8px; color: #fff; }
  
  h2 { font-size: 22px; font-weight: normal; color: #818cf8; margin-top: 0; }
  
  h3 { font-size: 24px; border-bottom: 1px solid #333; padding-bottom: 10px; margin-bottom: 20px; }
  
  /* p { font-size: 18px; color: #ccc; max-width: 600px; } */
</style>