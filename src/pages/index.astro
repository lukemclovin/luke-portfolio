---
import MainLayout from '../layouts/MainLayout.astro';
import ProjectCard from '../components/ProjectCard.astro';
---

<MainLayout title="Ibberson Studios">
  <section class="hero">
    <img src="/logos/ibberson-studios-logo-topbottom.png" alt="Ibberson Studios Logo" class="hero-logo" />
    <!-- <h1>Luke Ibberson</h1> -->
    <h2>Game & Software Developer | Computer Science (Games Technology) Graduate</h2>
    <p>I create interactive software across Unreal Engine, Unity, and Android, with experience in Blueprints, C#, and Java. My projects include VR applications, games, mobile software, accessibility-focused experiences, and this website.</p>
    <p>I enjoy solving technical problems, learning new technologies, and building software that has a meaningful impact on its users.</p>
  </section>

  <section class="projects">
    <h3>Featured Projects</h3>
    <ProjectCard 
      title="Skull Mania" 
      engine="Unreal Engine 5 (Blueprints)" 
      role="Solo Developer" 
      description="A search-and-sort VR game with a medievil-horror environment, featuring realistic physics and dynamic object interactions."
      slug = "skull-mania"
    />
    <ProjectCard 
      title="VisionBound" 
      engine="Unreal Engine 5 (Blueprints)" 
      role="Solo Developer" 
      description="A VR adaptation of Visual Resitution Therapy, designed to mitigate the effects of compensatory head movement and lack of accessibilty observed in clinical treatments."
      slug = "vision-bound"
    />
  </section>

  <section class="skills">
    <h3>Skills</h3>
    <h4>Languages & Scripting</h4>
    <!-- <p1>C#, Java, Blueprints, Typescript, HTML, CSS</p1> -->
    <ul><li>C#, Java, Blueprints, Typescript, HTML, CSS</li></ul>
    <h4>Game Engines</h4>
    <!-- <p1>Unreal Engine 5, Unity 6</p1> -->
    <ul><li>Unreal Engine 5, Unity 6</li></ul>
    <h4>Tools & Environments</h4>
    <!-- <p1>GitHub, Visual Studio, VS Code, Android Studio, Processing, Da Vinci Resolve, 3ds Max, Blender</p1> -->
    <ul><li>GitHub, Visual Studio, VS Code, Android Studio, Processing, Da Vinci Resolve, 3ds Max, Blender</li></ul>
    <h4>Technologies</h4>
    <!-- <p1>VR, AI-Assisted Development, 3D Asset Creation</p1> -->
    <ul><li>VR, AI-Assisted Development, 3D Asset Creation</li></ul>
  </section>
</MainLayout>

<style>
  .hero {
    margin-bottom: 40px;
  }

  .hero-logo {
    width: 300px;
    height: auto;
    margin-bottom: 16px;
    display: block;
    margin: auto;
  }
  
  h1 { font-size: 48px; margin-bottom: 8px; color: #fff; }
  
  h2 { font-size: 22px; font-weight: normal; color: #818cf8; margin-top: 30px; text-align: center; }
  
  h3 { font-size: 24px; color: #818cf8; border-bottom: 1px solid #333; padding-bottom: 10px; margin-bottom: 20px; }

  h4 { font-size: 20px; color: #fff; margin-top: 20px; }
  
  p { font-size: 18px; color: #ccc; max-width: auto; text-align: center; }

  p1 { font-size: 18px; color: #ccc; max-width: auto; }

  ul { font-size: 18px; color: #ccc; max-width: auto; list-style-type: disc; padding-left: 20px; }
</style>